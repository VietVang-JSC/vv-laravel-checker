# Normalize line endings to LF on checkin; check out as-is.
# The package's own phpcs standard (PSR-12) requires LF.
* text=auto eol=lf

# Keep the distributed archive to what a consumer actually needs. Everything
# below is development-only: shipping it inflates every `composer require` and
# puts files in the project that no runtime path touches.
/.github            export-ignore
/tests              export-ignore
/build              export-ignore
/reports            export-ignore
/docs               export-ignore
/tools              export-ignore
/resources/stubs    export-ignore
/vendor             export-ignore
/composer.lock      export-ignore
/.editorconfig      export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.phpunit.result.cache export-ignore
/phpstan.neon.dist  export-ignore
/phpstan-baseline.neon export-ignore
/phpunit.xml.dist   export-ignore
/phpcs.xml.dist     export-ignore
/CHANGELOG.md       export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md    export-ignore
/SECURITY.md        export-ignore
/SPEC.md            export-ignore
/UPGRADE.md         export-ignore
