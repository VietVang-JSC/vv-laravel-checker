{
    "name": "rampart/quality-checker",
    "description": "Laravel CLI quality gate: wraps phpcs, phpstan, phpunit, composer audit, trivy and adds custom PHP-Parser analyzers for security, missing tests and conventions.",
    "keywords": ["laravel", "quality", "phpcs", "phpstan", "phpunit", "security", "static-analysis", "ci"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/thiennhant95/Rampart",
    "support": {
        "issues": "https://github.com/thiennhant95/Rampart/issues",
        "source": "https://github.com/thiennhant95/Rampart",
        "docs": "https://github.com/thiennhant95/Rampart#readme"
    },
    "bin": [
        "bin/quality-check"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^6.0|^7.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "2.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=phpcs.xml.dist src tests tools",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "smoke": "php tools/smoke-install.php"
    },
    "autoload": {
        "psr-4": {
            "Rampart\\QualityChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rampart\\QualityChecker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rampart\\QualityChecker\\QualityCheckerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
